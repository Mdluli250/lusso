# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/lusso?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── PayFast ──────────────────────────────────────────────────────────────────
# Retrieve all values from your PayFast merchant dashboard → Settings.
# Sandbox dashboard: https://sandbox.payfast.co.za
# Live dashboard:    https://www.payfast.co.za

# Merchant credentials (server-side only — never expose to the browser)
PAYFAST_MERCHANT_ID="your-payfast-merchant-id"
PAYFAST_MERCHANT_KEY="your-payfast-merchant-key"

# Salt passphrase — set in PayFast Dashboard → Settings → Salt Passphrase.
# Required for subscriptions/tokenization; strongly recommended for all transactions.
PAYFAST_PASSPHRASE="your-payfast-passphrase"

# PayFast host — swap to www.payfast.co.za for production
# Sandbox:
PAYFAST_HOST="sandbox.payfast.co.za"
# Live (uncomment for production):
# PAYFAST_HOST="www.payfast.co.za"

# Set to "true" in local/sandbox development to bypass the ITN source-IP check
# (PayFast cannot reach localhost, so IP validation will always fail locally).
# NEVER set this to true in production.
PAYFAST_SKIP_IP_CHECK="true"

# ─── PayFast (client-side / public) ───────────────────────────────────────────
# Onsite engine.js URL — must match the PAYFAST_HOST environment above.
# Sandbox:
NEXT_PUBLIC_PAYFAST_ENGINE_JS_URL="https://sandbox.payfast.co.za/onsite/engine.js"
# Live (uncomment for production):
# NEXT_PUBLIC_PAYFAST_ENGINE_JS_URL="https://www.payfast.co.za/onsite/engine.js"

# ─── Storage ───────────────────────────────────────────────────────────────────
# Local path where generated invoices and receipts are stored.
# Defaults to ./storage/documents if not set.
DOCUMENT_STORAGE_PATH="./storage/documents"

# Vercel Blob token for product image uploads (optional in development).
# Leave unset or set to the placeholder value to use local filesystem uploads.
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# ─── Cron jobs ────────────────────────────────────────────────────────────────
# Secret used to authenticate requests to /api/subscriptions/trigger.
# Generate with: openssl rand -base64 32
CRON_SECRET="generate-with: openssl rand -base64 32"

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Optional Redis URL for distributed rate limiting.
# Falls back to an in-process memory store if not set (fine for a single instance).
# RATE_LIMIT_REDIS_URL="redis://localhost:6379"
