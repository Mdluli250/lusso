# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/lusso?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Peach Payments (Orchestration) ───────────────────────────────────────────
# Retrieve all values from the Peach Payments Dashboard → Checkout → API keys
# Sandbox dashboard: https://sandbox-dashboard.peachpayments.com
# Live dashboard:    https://dashboard.peachpayments.com

# OAuth credentials (server-side only — never expose to the browser)
PEACH_CLIENT_ID="your-peach-client-id"
PEACH_CLIENT_SECRET="your-peach-client-secret"
PEACH_MERCHANT_ID="your-peach-merchant-id"
PEACH_ENTITY_ID="your-peach-entity-id"

# Webhook signing secret
# Enable webhook signing in the Dashboard → Checkout → Webhook security
# and paste the generated secret here.
PEACH_WEBHOOK_SECRET="your-peach-webhook-signing-secret"

# Service base URLs — swap to live values when going to production
# Sandbox:
PEACH_AUTH_URL="https://sandbox-dashboard.peachpayments.com"
PEACH_CHECKOUT_URL="https://sandbox-checkout.peachpayments.com"
# Live (uncomment for production):
# PEACH_AUTH_URL="https://dashboard.peachpayments.com"
# PEACH_CHECKOUT_URL="https://secure.peachpayments.com"

# ─── Peach Payments (client-side / public) ────────────────────────────────────
# Entity ID is safe to expose — it is required by the Embedded Checkout SDK.
NEXT_PUBLIC_PEACH_ENTITY_ID="your-peach-entity-id"

# checkout.js SDK URL — must match the environment above
# Sandbox:
NEXT_PUBLIC_PEACH_CHECKOUT_JS_URL="https://sandbox-checkout.peachpayments.com/js/checkout.js"
# Live (uncomment for production):
# NEXT_PUBLIC_PEACH_CHECKOUT_JS_URL="https://secure.peachpayments.com/js/checkout.js"

# ─── Storage ───────────────────────────────────────────────────────────────────
# Local path where generated invoices and receipts are stored.
# Defaults to ./storage/documents if not set.
DOCUMENT_STORAGE_PATH="./storage/documents"

# Vercel Blob token for product image uploads (optional in development).
# Leave unset or set to the placeholder value to use local filesystem uploads.
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# ─── Cron jobs ────────────────────────────────────────────────────────────────
# Secret used to authenticate requests to /api/subscriptions/trigger.
# Generate with: openssl rand -base64 32
CRON_SECRET="generate-with: openssl rand -base64 32"

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Optional Redis URL for distributed rate limiting.
# Falls back to an in-process memory store if not set (fine for a single instance).
# RATE_LIMIT_REDIS_URL="redis://localhost:6379"
