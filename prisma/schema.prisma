generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SubscriptionFrequency {
  MONTHLY
  BI_MONTHLY
  QUARTERLY
}

// ─── NextAuth.js Models ───────────────────────────────────────────

model User {
  id                   String           @id @default(cuid())
  name                 String?
  email                String           @unique
  emailVerified        DateTime?
  image                String?
  role                 UserRole         @default(CUSTOMER)
  // Credential auth fields
  password             String?          @db.Text
  passwordResetToken   String?          @unique
  passwordResetExpires DateTime?
  shippingAddress      ShippingAddress?
  accounts             Account[]
  orders               Order[]
  wishlistItems        WishlistItem[]
  reviews              Review[]
  recentlyViewed       RecentlyViewed[]
  subscriptions        Subscription[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ─── Product Models ───────────────────────────────────────────────

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String           @db.Text
  price          Int // Price in ZAR cents (e.g. 34900 = R349.00)
  burnTimeHours  Int
  waxType        String // e.g. "soy", "beeswax", "coconut"
  scentProfile   String // e.g. "lavender", "cinnamon"
  image          String?
  isActive       Boolean          @default(true)
  variants       ProductVariant[]
  images         ProductImage[]
  wishlistItems  WishlistItem[]
  reviews        Review[]
  recentlyViewed RecentlyViewed[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id            String         @id @default(cuid())
  productId     String
  scent         String
  waxType       String
  colorHex      String // e.g. "#9B59B6"
  modelPath     String // e.g. "/models/lavender-soy.glb"
  stock         Int            @default(0)
  subscriptions Subscription[]

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Order Model ──────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model ShippingAddress {
  id           String   @id @default(cuid())
  userId       String   @unique
  recipient    String   @db.VarChar(120)
  phone        String   @db.VarChar(30)
  addressLine1 String   @db.VarChar(180)
  addressLine2 String?  @db.VarChar(180)
  city         String   @db.VarChar(100)
  province     String   @db.VarChar(100)
  postalCode   String   @db.VarChar(20)
  country      String   @default("South Africa") @db.VarChar(80)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id                    String      @id @default(cuid())
  userId                String
  status                OrderStatus @default(PENDING)
  totalAmountZAR        Int // In ZAR cents
  merchantTransactionId String      @unique
  paymentStatus         String? // Raw payment_status string from PayFast ITN
  items                 Json // Snapshot of cart items at time of purchase
  invoicePath           String? // Relative path to generated invoice PDF
  receiptPath           String? // Relative path to generated receipt PDF
  giftWrap              Boolean     @default(false)
  giftMessage           String?     @db.VarChar(200)
  discountData          Json?
  subscriptionId        String?
  shippingAddress       Json?
  shippingAmountZAR     Int                 @default(0)
  fulfillmentStatus     FulfillmentStatus   @default(UNFULFILLED)
  carrier               String?             @db.VarChar(100)
  trackingNumber        String?             @db.VarChar(200)
  shippedAt             DateTime?
  deliveredAt           DateTime?
  refundedAt            DateTime?
  refundReference       String?             @db.VarChar(200)
  refundAmountZAR       Int                 @default(0)
  payfastPaymentId      String?
  reservationExpiresAt  DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([merchantTransactionId])
}

// ─── Wishlist ─────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ─── Reviews ──────────────────────────────────────────────────────

model Review {
  id        String       @id @default(cuid())
  userId    String
  productId String
  rating    Int
  text      String?      @db.VarChar(1000)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([status])
}

// ─── Email Capture ────────────────────────────────────────────────

model EmailCapture {
  id           String   @id @default(cuid())
  email        String   @unique
  discountCode String   @unique
  createdAt    DateTime @default(now())
}

// ─── Recently Viewed ──────────────────────────────────────────────

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt(sort: Desc)])
}

// ─── CMS Content Blocks ───────────────────────────────────────────

enum ContentType {
  text
  rich_text
  image
  json
}

model ContentBlock {
  id          String      @id @default(cuid())
  key         String      @unique
  type        ContentType @default(text)
  value       String      @db.Text
  label       String?
  description String?
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  @@index([key])
}

// ─── Subscriptions ────────────────────────────────────────────────

model Subscription {
  id             String                @id @default(cuid())
  userId         String
  variantId      String
  frequency      SubscriptionFrequency
  status         SubscriptionStatus    @default(ACTIVE)
  nextDeliveryAt DateTime?
  failureReason  String?
  token          String?               @db.VarChar(255)
  paymentMethod  String?               @db.VarChar(80)
  lastChargedAt  DateTime?
  retryCount     Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, nextDeliveryAt])
}

model NotificationLog {
  id        String   @id @default(cuid())
  key       String   @unique
  type      String   @db.VarChar(80)
  recipient String   @db.VarChar(254)
  sentAt    DateTime @default(now())
}

// ─── Discount Codes ───────────────────────────────────────────────

model DiscountCode {
  id                   String         @id @default(cuid())
  code                 String         @unique
  type                 DiscountType
  value                Int
  minOrderAmountZAR    Int            @default(0)
  maxUsageCount        Int?
  perUserLimit         Int?
  maxDiscountAmountZAR Int?
  stackable            Boolean        @default(false)
  startDate            DateTime?
  endDate              DateTime?
  active               Boolean        @default(true)
  applicableProductIds String[]
  usages               DiscountUsage[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([active, startDate, endDate])
}

// ─── Gallery Images ───────────────────────────────────────────────

model GalleryImage {
  id        String   @id @default(cuid())
  blobUrl   String   @unique @db.VarChar(2048)
  alt       String   @db.VarChar(150)
  width     Int
  height    Int
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─── Return Requests ──────────────────────────────────────────────

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model ReturnRequest {
  id        String              @id @default(cuid())
  orderId   String
  userId    String
  reason    String              @db.VarChar(1000)
  items     Json                // Array of { name, quantity } being returned
  status    ReturnRequestStatus @default(PENDING)
  adminNote String?             @db.VarChar(500)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

// ─── Discount Usage ───────────────────────────────────────────────

model DiscountUsage {
  id                String        @id @default(cuid())
  discountCodeId    String?
  emailCaptureCode  String?
  userId            String
  orderId           String
  discountAmountZAR Int
  createdAt         DateTime      @default(now())

  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  @@index([discountCodeId])
  @@index([userId])
  @@index([emailCaptureCode])
}
